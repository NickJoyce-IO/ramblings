---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title,
	description = 'Thoughts on AI-assisted development in UK Government, and on learning to code with agents again.',
} = Astro.props;

const pageTitle = title ? `${title} | Ramblings` : 'Ramblings';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={canonical} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header">
			<a class="site-title" href="/">Ramblings</a>
			<nav class="site-nav" aria-label="Main">
				<a href="/">Home</a>
				<a href="/posts/">Posts</a>
			</nav>
		</header>
		<main id="main">
			<slot />
		</main>
		<footer class="site-footer">
			<p>Views are my own. <a href="/how-this-is-made/">How this is made</a></p>
		</footer>
	</body>
</html>
