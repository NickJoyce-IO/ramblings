---
import { formatDate, kindLabels, type Post } from '../lib/posts';

interface Props {
	posts: Post[];
	headingLevel?: 'h2' | 'h3';
}

const { posts, headingLevel: Heading = 'h2' } = Astro.props;
---

{
	posts.length === 0 ? (
		<p>No posts yet.</p>
	) : (
		<ul class="post-list">
			{posts.map((post) => (
				<li>
					<Heading>
						<a href={`/posts/${post.id}/`}>{post.data.title}</a>
					</Heading>
					<p class="meta">
						{post.data.draft && <span class="draft-badge">Draft · </span>}
						{kindLabels[post.data.kind]} · <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
					</p>
					<p>{post.data.description}</p>
				</li>
			))}
		</ul>
	)
}
