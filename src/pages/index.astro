---
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/posts';

const latest = (await getPosts()).slice(0, 5);
---

<BaseLayout>
	<h1>Ramblings</h1>
	<p>
		Thoughts on applying AI-assisted development inside UK Government, and on learning to code with agents again.
	</p>

	<h2>Latest</h2>
	<PostList posts={latest} headingLevel="h3" />
	<p><a href="/posts/">All posts</a></p>
</BaseLayout>
