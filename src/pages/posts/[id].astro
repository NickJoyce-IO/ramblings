---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPosts, kindLabels, seriesSlug } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, kind, date, series, draft } = post.data;
---

<BaseLayout title={title} description={description}>
	<article>
		<header>
			<p class="meta">
				{draft && <span class="draft-badge">Draft · </span>}
				{kindLabels[kind]} · <time datetime={date.toISOString()}>{formatDate(date)}</time>
				{series && <> · Series: <a href={`/series/${seriesSlug(series)}/`}>{series}</a></>}
			</p>
			<h1>{title}</h1>
		</header>
		<div class="prose">
			<Content />
		</div>
	</article>
</BaseLayout>
